# Cloudflare credentials used by the MCP server.
# Create an API token with the "Cloudflare Pages: Edit" permission:
#   https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-api-token
# Account ID is shown on the right sidebar of any domain's overview page,
# or under Workers & Pages → Account details.
CLOUDFLARE_ACCOUNT_ID=your-account-id
