# =============================================================================
# cloudflare-pages-mcp environment configuration
# Copy to .env (never commit .env) and fill in your Cloudflare credentials.
# =============================================================================

# -- Cloudflare credentials (required) ----------------------------------------

# API token with the "Cloudflare Pages: Edit" permission.
# Create one at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-api-token

# Your Cloudflare account ID. Shown in the right sidebar of any domain's
# overview page, or under Workers & Pages -> Account details.
CLOUDFLARE_ACCOUNT_ID=your-account-id
