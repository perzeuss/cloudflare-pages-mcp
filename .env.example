# --- Required: Cloudflare credentials ----------------------------------------
# API token with the "Cloudflare Pages: Edit" permission.
CLOUDFLARE_API_TOKEN=
# Account ID that owns the Pages projects.
CLOUDFLARE_ACCOUNT_ID=
# Override the API base URL (rarely needed; defaults to the public API).
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# --- Server ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Public URL this server is reachable at (also the default OAuth issuer).
PUBLIC_BASE_URL=

# --- Auth: static token (simple) ---------------------------------------------
# If set, every POST /mcp must send "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=

# --- Auth: OAuth 2.1 (for Claude custom connectors) --------------------------
# Set OAUTH_PASSWORD to enable the built-in OAuth server. Users enter this
# password on the consent screen. Requires a public https PUBLIC_BASE_URL
# (or OAUTH_ISSUER_URL).
OAUTH_PASSWORD=
# OAUTH_ISSUER_URL defaults to PUBLIC_BASE_URL when unset.
OAUTH_ISSUER_URL=
# HMAC secret for signing tokens. Generate: openssl rand -hex 32
OAUTH_SIGNING_SECRET=
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# --- Large binary uploads (optional) -----------------------------------------
# HMAC secret for signing short-lived direct-upload URLs (create_upload_url).
# Defaults to OAUTH_SIGNING_SECRET, or a per-process random value if unset.
# Set it (openssl rand -hex 32) so upload URLs survive restarts in production.
# Direct uploads also require PUBLIC_BASE_URL so a reachable URL can be built.
UPLOAD_SIGNING_SECRET=

# --- Hardening (optional) ----------------------------------------------------
TRUST_PROXY=1
MAX_BODY_SIZE=25mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Comma-separated Origin allow-list for the /mcp endpoint (optional).
ALLOWED_ORIGINS=
