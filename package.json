{
  "name": "cloudflare-pages-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server (HTTP + OAuth 2.1) to create Cloudflare Pages projects and deploy files (e.g. Claude-generated HTML) to a live *.pages.dev site via the Direct Upload API. Usable as a Claude custom connector.",
  "type": "module",
  "license": "MIT",
  "author": "Pascal Malbranche",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perzeuss/cloudflare-pages-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/perzeuss/cloudflare-pages-mcp/issues"
  },
  "homepage": "https://github.com/perzeuss/cloudflare-pages-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "connector",
    "cloudflare",
    "cloudflare-pages",
    "deploy",
    "static-site",
    "direct-upload"
  ],
  "bin": {
    "cloudflare-pages-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --test-concurrency=1 --experimental-test-coverage \"test/**/*.test.ts\"",
    "release": "semantic-release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "blake3-wasm": "2.1.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "22.10.5",
    "@types/supertest": "^7.2.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "semantic-release": "24.2.9",
    "supertest": "^7.2.2",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0"
  }
}
